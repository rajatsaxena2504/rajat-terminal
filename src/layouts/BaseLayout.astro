---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Builder, reader, creator." } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Regular nav links
const navLinks = [
  { href: `${base}blogs/`, label: 'Blog' },
  { href: `${base}projects/`, label: 'Projects' },
  { href: `${base}books/`, label: 'Books' },
];

// Dropdown for learning content
const learnDropdown = {
  label: 'Learn',
  items: [
    { href: `${base}papers/`, label: 'Papers', desc: 'arXiv paper notes' },
    { href: `${base}system-design/`, label: 'System Design', desc: 'Architecture & patterns' },
    { href: `${base}ai-guide/`, label: 'AI Guide', desc: 'AI/ML resources' },
  ],
};

// More dropdown
const moreDropdown = {
  label: 'More',
  items: [
    { href: `${base}list-100/`, label: 'List 100', desc: 'Life goals' },
  ],
};

function isActive(href: string): boolean {
  return currentPath.includes(href.replace(base, ''));
}

function isDropdownActive(items: { href: string }[]): boolean {
  return items.some(item => isActive(item.href));
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} · rajat.terminal</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · rajat.terminal`} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <!-- Header - PATTERN D: FLOATING ISLAND -->
    <header class="floating-header">
      <div class="floating-island">
        <!-- Logo -->
        <a href={base} class="island-logo">
          R<span>.</span>
        </a>

        <!-- Nav links -->
        <nav class="island-nav" id="nav-menu">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`island-link ${isActive(link.href) ? 'active' : ''}`}
            >
              {link.label}
            </a>
          ))}

          <!-- Learn Dropdown -->
          <div class={`nav-dropdown ${isDropdownActive(learnDropdown.items) ? 'active' : ''}`}>
            <button class="island-link dropdown-trigger">
              {learnDropdown.label}
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 5l3 3 3-3" />
              </svg>
            </button>
            <div class="dropdown-menu">
              {learnDropdown.items.map((item) => (
                <a href={item.href} class={`dropdown-item ${isActive(item.href) ? 'active' : ''}`}>
                  <span class="dropdown-item-label">{item.label}</span>
                  <span class="dropdown-item-desc">{item.desc}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- More Dropdown -->
          <div class={`nav-dropdown ${isDropdownActive(moreDropdown.items) ? 'active' : ''}`}>
            <button class="island-link dropdown-trigger">
              {moreDropdown.label}
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 5l3 3 3-3" />
              </svg>
            </button>
            <div class="dropdown-menu">
              {moreDropdown.items.map((item) => (
                <a href={item.href} class={`dropdown-item ${isActive(item.href) ? 'active' : ''}`}>
                  <span class="dropdown-item-label">{item.label}</span>
                  <span class="dropdown-item-desc">{item.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </nav>

        <!-- Search icon -->
        <button class="island-search" id="cmd-trigger" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </button>

        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Main -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer scroll-reveal">
      <div class="container-main">
        <div class="footer-content">
          <span>&copy; {new Date().getFullYear()} Rajat</span>
          <div class="social-links">
            <a href="https://github.com/rajatsaxena2504" class="social-link" target="_blank" rel="noopener">
              GitHub
            </a>
            <a href="https://twitter.com/rajatsaxena2504" class="social-link" target="_blank" rel="noopener">
              Twitter
            </a>
            <a href="https://www.linkedin.com/in/rajat-saxena-791aa650/" class="social-link" target="_blank" rel="noopener">
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Dropdown toggle
      document.querySelectorAll('.dropdown-trigger').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const dropdown = trigger.closest('.nav-dropdown');
          // Close other dropdowns
          document.querySelectorAll('.nav-dropdown').forEach(d => {
            if (d !== dropdown) d.classList.remove('open');
          });
          dropdown?.classList.toggle('open');
        });
      });

      // Close dropdowns when clicking outside
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.nav-dropdown')) {
          document.querySelectorAll('.nav-dropdown').forEach(d => d.classList.remove('open'));
        }
      });

      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.nav-dropdown').forEach(d => d.classList.remove('open'));
        }
      });

      // Scroll-triggered animations with Intersection Observer
      const scrollRevealElements = document.querySelectorAll('.scroll-reveal');

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            // Optional: unobserve after revealing (animate once)
            revealObserver.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      scrollRevealElements.forEach(el => revealObserver.observe(el));

      // Parallax effect on background gradient
      const parallaxBg = document.querySelector('.bio-bg-gradient');
      if (parallaxBg) {
        window.addEventListener('scroll', () => {
          const scrollY = window.scrollY;
          (parallaxBg as HTMLElement).style.transform = `translateY(${scrollY * 0.3}px)`;
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  /* Dropdown styles - enhanced */
  .nav-dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--foreground-secondary);
    background: none;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dropdown-trigger:hover {
    color: var(--foreground);
    background: rgba(48, 54, 61, 0.6);
  }

  .nav-dropdown.active .dropdown-trigger {
    color: var(--accent);
    background: var(--accent-muted);
  }

  .dropdown-trigger svg {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.7;
  }

  .nav-dropdown:hover .dropdown-trigger svg,
  .nav-dropdown.open .dropdown-trigger svg {
    transform: rotate(180deg);
    opacity: 1;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: 8px;
    background: rgba(22, 27, 34, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s ease;
    z-index: 100;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 8px;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .dropdown-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: var(--accent);
    border-radius: 0 2px 2px 0;
    transition: height 0.2s ease;
  }

  .dropdown-item:hover {
    background: rgba(48, 54, 61, 0.5);
    padding-left: 18px;
  }

  .dropdown-item:hover::before {
    height: 50%;
  }

  .dropdown-item.active {
    background: var(--accent-muted);
  }

  .dropdown-item.active::before {
    height: 50%;
  }

  .dropdown-item-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--foreground);
    transition: color 0.2s ease;
  }

  .dropdown-item:hover .dropdown-item-label {
    color: var(--accent);
  }

  .dropdown-item-desc {
    font-size: 12px;
    color: var(--foreground-muted);
  }

  /* Command palette trigger responsive */
  .cmd-trigger .cmd-text {
    display: inline;
  }

  @media (max-width: 900px) {
    .cmd-trigger .cmd-text {
      display: none;
    }
    .cmd-trigger kbd {
      display: none;
    }
  }

  /* Mobile dropdown adjustments */
  @media (max-width: 768px) {
    .cmd-trigger {
      display: none;
    }

    .nav-dropdown {
      width: 100%;
    }

    .dropdown-trigger {
      width: 100%;
      justify-content: space-between;
      padding: 12px 16px;
    }

    .dropdown-trigger::before {
      display: none;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      background: transparent;
      backdrop-filter: none;
      padding: 4px 0 4px 16px;
      display: none;
      min-width: auto;
    }

    .nav-dropdown.open .dropdown-menu {
      display: block;
    }

    .dropdown-item {
      padding: 10px 14px;
    }

    .dropdown-item::before {
      display: none;
    }

    .dropdown-item:hover {
      padding-left: 14px;
    }
  }
</style>
