---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Get system design notes
const allNotes = await getCollection('notes', ({ data }) => !data.draft && data.category === 'system-design');
const sortedNotes = allNotes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Topics for system design
const topics = [
  { id: 'fundamentals', label: 'Fundamentals', icon: '📐' },
  { id: 'databases', label: 'Databases', icon: '🗄️' },
  { id: 'caching', label: 'Caching', icon: '⚡' },
  { id: 'messaging', label: 'Message Queues', icon: '📬' },
  { id: 'scaling', label: 'Scaling', icon: '📈' },
  { id: 'case-studies', label: 'Case Studies', icon: '🏗️' },
];
---

<BaseLayout title="System Design" description="Learning system design concepts, patterns, and case studies.">
  <div class="container-main">
    <section class="hero" style="padding-bottom: 40px;">
      <h1 class="hero-title">System Design</h1>
      <p class="hero-intro">
        Notes and learnings on designing scalable, reliable, and maintainable systems.
        From fundamentals to real-world case studies.
      </p>
    </section>

    <!-- Topic Cards -->
    <section class="topics-section">
      <h2 class="section-title">Topics</h2>
      <div class="topics-grid">
        {topics.map((topic) => (
          <a href={`${base}system-design/${topic.id}/`} class="topic-card">
            <span class="topic-icon">{topic.icon}</span>
            <span class="topic-label">{topic.label}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Recent Notes -->
    <section class="section">
      <h2 class="section-title">Recent Notes</h2>
      {sortedNotes.length > 0 ? (
        <div class="notes-list">
          {sortedNotes.map((note) => (
            <a href={`${base}notes/${note.slug}/`} class="note-row">
              <div class="note-content">
                <span class="note-title">{note.data.title}</span>
                {note.data.tags.length > 0 && (
                  <div class="note-tags">
                    {note.data.tags.slice(0, 3).map((tag) => (
                      <span class="tag-tiny">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <span class="note-date">
                {note.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p style="color: var(--foreground-muted); padding: 24px 0;">
          System design notes coming soon! Check out the <a href={`${base}notes/`} style="color: var(--accent);">general notes</a> in the meantime.
        </p>
      )}
    </section>

    <!-- Resources -->
    <section class="section">
      <h2 class="section-title">Recommended Resources</h2>
      <div class="resources-list">
        <a href="https://github.com/donnemartin/system-design-primer" target="_blank" rel="noopener" class="resource-item">
          <span class="resource-title">System Design Primer</span>
          <span class="resource-meta">GitHub · Comprehensive guide</span>
        </a>
        <a href="https://www.youtube.com/@ByteByteGo" target="_blank" rel="noopener" class="resource-item">
          <span class="resource-title">ByteByteGo</span>
          <span class="resource-meta">YouTube · Visual explanations</span>
        </a>
        <div class="resource-item">
          <span class="resource-title">Designing Data-Intensive Applications</span>
          <span class="resource-meta">Book · Martin Kleppmann</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .topics-section {
    padding-bottom: 32px;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 20px 16px;
    background: var(--background-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: all 0.2s ease;
    text-align: center;
  }

  .topic-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .topic-icon {
    font-size: 28px;
  }

  .topic-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--foreground);
  }

  .notes-list {
    display: flex;
    flex-direction: column;
  }

  .note-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    gap: 16px;
  }

  .note-row:hover {
    padding-left: 8px;
  }

  .note-row:last-child {
    border-bottom: none;
  }

  .note-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .note-title {
    font-size: 16px;
    font-weight: 500;
  }

  .note-tags {
    display: flex;
    gap: 6px;
  }

  .tag-tiny {
    font-size: 11px;
    padding: 2px 8px;
    background: var(--background-secondary);
    color: var(--foreground-muted);
    border-radius: 4px;
  }

  .note-date {
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--foreground-muted);
    flex-shrink: 0;
  }

  .resources-list {
    display: flex;
    flex-direction: column;
  }

  .resource-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .resource-item:last-child {
    border-bottom: none;
  }

  .resource-title {
    font-size: 15px;
    font-weight: 500;
  }

  .resource-meta {
    font-size: 13px;
    color: var(--foreground-muted);
  }

  @media (max-width: 640px) {
    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .note-row, .resource-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>
