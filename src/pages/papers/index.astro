---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Get all paper notes
const allPapers = await getCollection('papers', ({ data }) => !data.draft);
const sortedPapers = allPapers.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group by month/year
const papersByMonth = sortedPapers.reduce((acc, paper) => {
  const monthYear = paper.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  if (!acc[monthYear]) acc[monthYear] = [];
  acc[monthYear].push(paper);
  return acc;
}, {} as Record<string, typeof sortedPapers>);

const months = Object.keys(papersByMonth);
---

<BaseLayout title="Papers" description="Notes and learnings from research papers I'm reading.">
  <div class="container-main">
    <section class="hero" style="padding-bottom: 40px;">
      <h1 class="hero-title">Paper Notes</h1>
      <p class="hero-intro">
        Learnings from research papers, mostly from arXiv. I read papers on ML, distributed systems,
        and whatever catches my interest. These are my notes and key takeaways.
      </p>
    </section>

    {sortedPapers.length === 0 ? (
      <div style="padding: 40px 0; text-align: center;">
        <p style="color: var(--foreground-muted); margin-bottom: 16px;">No paper notes yet.</p>
        <p style="color: var(--foreground-muted); font-size: 14px;">
          Check back soon - I'm always reading something interesting!
        </p>
      </div>
    ) : (
      months.map((month) => (
        <div class="posts-by-year">
          <div class="year-label">{month}</div>
          {papersByMonth[month].map((paper) => (
            <a href={`${base}papers/${paper.slug}/`} class="paper-item">
              <div class="paper-content">
                <span class="post-title">
                  <span class="post-title-wrapper">{paper.data.title}</span>
                </span>
                {paper.data.tldr && (
                  <span class="paper-tldr">{paper.data.tldr}</span>
                )}
                <div class="paper-meta">
                  {paper.data.tags.slice(0, 3).map((tag) => (
                    <span class="tag-small">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="paper-right">
                <span class="post-date">
                  {paper.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }).toUpperCase()}
                </span>
                <span class="post-arrow">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      ))
    )}
  </div>
</BaseLayout>

<style>
  .paper-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 18px 16px;
    margin: 0 -16px;
    border-radius: 8px;
    text-decoration: none;
    position: relative;
    gap: 16px;
    transition: background 0.3s ease;
  }

  /* Separator lines */
  .paper-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16px;
    right: 16px;
    height: 1px;
    background: var(--border);
    transition: opacity 0.3s ease;
  }

  .paper-item:first-child::before {
    display: none;
  }

  .paper-item:hover::before {
    opacity: 0;
  }

  .paper-item:hover {
    background: rgba(88, 166, 255, 0.04);
  }

  .paper-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--foreground);
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  /* Title wrapper for bracket effect */
  .post-title-wrapper {
    position: relative;
    display: inline;
  }

  /* Corner brackets */
  .post-title-wrapper::before,
  .post-title-wrapper::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    opacity: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Top-left corner */
  .post-title-wrapper::before {
    top: -4px;
    left: -12px;
    border-top: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
    transform: translate(4px, 4px);
  }

  /* Bottom-right corner */
  .post-title-wrapper::after {
    bottom: -4px;
    right: -12px;
    border-bottom: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
    transform: translate(-4px, -4px);
  }

  .paper-item:hover .post-title-wrapper::before,
  .paper-item:hover .post-title-wrapper::after {
    opacity: 1;
    transform: translate(0, 0);
  }

  .paper-tldr {
    font-size: 14px;
    color: var(--foreground-muted);
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .paper-item:hover .paper-tldr {
    color: var(--foreground-secondary);
  }

  .paper-meta {
    display: flex;
    gap: 6px;
    margin-top: 4px;
  }

  .tag-small {
    font-size: 11px;
    padding: 2px 8px;
    background: var(--background-secondary);
    color: var(--foreground-muted);
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    transition: all 0.3s ease;
  }

  .paper-item:hover .tag-small {
    background: rgba(88, 166, 255, 0.1);
    color: var(--accent);
  }

  .paper-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .post-date {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--foreground-muted);
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
  }

  .paper-item:hover .post-date {
    color: var(--accent);
  }

  /* Arrow indicator */
  .post-arrow {
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--accent);
  }

  .paper-item:hover .post-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .paper-item {
      flex-direction: column;
      padding: 14px 12px;
      margin: 0 -12px;
      gap: 8px;
    }

    .paper-item::before {
      left: 12px;
      right: 12px;
    }

    .paper-right {
      align-self: flex-start;
    }

    .post-arrow {
      display: none;
    }

    .post-title-wrapper::before,
    .post-title-wrapper::after {
      display: none;
    }
  }
</style>
