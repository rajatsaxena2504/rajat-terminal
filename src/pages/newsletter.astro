---
import BaseLayout from '../layouts/BaseLayout.astro';

const issues = [
  { number: 12, title: "The Rise of AI Agents", date: "Dec 20, 2024" },
  { number: 11, title: "Reading Research Papers Effectively", date: "Dec 13, 2024" },
  { number: 10, title: "Building in Public: Lessons Learned", date: "Dec 6, 2024" },
  { number: 9, title: "The Best Books I Read in 2024", date: "Nov 29, 2024" },
];
---

<BaseLayout title="Newsletter" description="Weekly insights on AI, engineering, and building.">
  <div class="container-main">
    <section class="hero" style="padding-bottom: 40px;">
      <h1 class="hero-title">Newsletter</h1>
      <p class="hero-intro">
        Weekly thoughts on AI, engineering, books, and building things.
      </p>
    </section>

    <!-- Subscribe -->
    <section style="padding: 32px; background: var(--background-secondary); border-radius: 8px; margin-bottom: 48px;">
      <h2 style="font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 500; margin-bottom: 16px;">
        Subscribe
      </h2>
      <p style="color: var(--foreground-secondary); margin-bottom: 20px; font-size: 15px;">
        Join 1,000+ readers. No spam, unsubscribe anytime.
      </p>
      <form style="display: flex; gap: 12px;">
        <input
          type="email"
          placeholder="you@example.com"
          style="flex: 1; padding: 12px 16px; background: var(--background); border: 1px solid var(--border); border-radius: 6px; color: var(--foreground); font-size: 14px;"
          required
        />
        <button
          type="submit"
          style="padding: 12px 24px; background: var(--accent); color: white; border: none; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer;"
        >
          Subscribe
        </button>
      </form>
    </section>

    <!-- Past Issues -->
    <section class="section" style="border-top: none; padding-top: 0;">
      <h2 class="section-title">Past Issues</h2>
      <div class="links-list">
        {issues.map((issue) => (
          <a href="#" class="link-item">
            <div>
              <span style="font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--accent);">
                #{issue.number}
              </span>
              <span class="link-title" style="margin-left: 12px;">{issue.title}</span>
            </div>
            <span class="link-meta">{issue.date}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
