---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Get all notes
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const sortedNotes = allNotes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get unique categories
const categories = [...new Set(allNotes.map(note => note.data.category))];

// Category labels
const categoryLabels: Record<string, string> = {
  'system-design': 'System Design',
  'distributed-systems': 'Distributed Systems',
  'algorithms': 'Algorithms',
  'databases': 'Databases',
  'ml': 'Machine Learning',
  'web': 'Web Development',
  'devops': 'DevOps',
  'other': 'Other',
};

// Group by date (for timeline view)
const notesByDate = sortedNotes.reduce((acc, note) => {
  const date = note.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  if (!acc[date]) acc[date] = [];
  acc[date].push(note);
  return acc;
}, {} as Record<string, typeof sortedNotes>);

const dates = Object.keys(notesByDate);
---

<BaseLayout title="Notes" description="Daily learnings on system design, distributed systems, and more.">
  <div class="container-main">
    <section class="hero" style="padding-bottom: 40px;">
      <h1 class="hero-title">Learning Notes</h1>
      <p class="hero-intro">
        Quick notes and learnings from my daily study sessions. Topics include system design,
        distributed systems, algorithms, and whatever I'm currently exploring.
      </p>
    </section>

    {categories.length > 0 && (
      <div class="category-filters">
        {categories.map((cat) => (
          <span class="category-tag" data-category={cat}>
            {categoryLabels[cat] || cat}
          </span>
        ))}
      </div>
    )}

    {sortedNotes.length === 0 ? (
      <div style="padding: 40px 0; text-align: center;">
        <p style="color: var(--foreground-muted); margin-bottom: 16px;">No notes yet.</p>
        <p style="color: var(--foreground-muted); font-size: 14px;">
          Learning happens daily - notes coming soon!
        </p>
      </div>
    ) : (
      <div class="notes-timeline">
        {dates.map((date) => (
          <div class="date-group">
            <div class="date-label">{date}</div>
            <div class="notes-list">
              {notesByDate[date].map((note) => (
                <a href={`${base}notes/${note.slug}/`} class="note-item">
                  <div class="note-category">
                    {categoryLabels[note.data.category] || note.data.category}
                  </div>
                  <div class="note-title">{note.data.title}</div>
                  {note.data.tags.length > 0 && (
                    <div class="note-tags">
                      {note.data.tags.slice(0, 3).map((tag) => (
                        <span class="tag-tiny">{tag}</span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .category-tag {
    padding: 6px 12px;
    font-size: 13px;
    background: var(--background-secondary);
    color: var(--foreground-secondary);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .category-tag:hover {
    background: var(--accent);
    color: white;
  }

  .notes-timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .date-group {
    display: flex;
    gap: 24px;
  }

  .date-label {
    flex-shrink: 0;
    width: 100px;
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--foreground-muted);
    padding-top: 4px;
  }

  .notes-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .note-item {
    padding: 16px;
    background: var(--background-secondary);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .note-item:hover {
    transform: translateX(4px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .note-category {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .note-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--foreground);
  }

  .note-tags {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }

  .tag-tiny {
    font-size: 11px;
    padding: 2px 6px;
    background: var(--background);
    color: var(--foreground-muted);
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .date-group {
      flex-direction: column;
      gap: 8px;
    }

    .date-label {
      width: auto;
    }
  }
</style>
