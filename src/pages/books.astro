---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentlyReading = [
  { title: "Staff Engineer", author: "Will Larson" },
  { title: "The Art of Doing Science and Engineering", author: "Richard Hamming" },
];

const completed = [
  { title: "Designing Data-Intensive Applications", author: "Martin Kleppmann", rating: 5 },
  { title: "The Pragmatic Programmer", author: "David Thomas & Andrew Hunt", rating: 5 },
  { title: "Thinking, Fast and Slow", author: "Daniel Kahneman", rating: 4 },
  { title: "Atomic Habits", author: "James Clear", rating: 4 },
  { title: "Deep Work", author: "Cal Newport", rating: 5 },
  { title: "Zero to One", author: "Peter Thiel", rating: 4 },
];

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<BaseLayout title="Books" description="What I'm reading and have read.">
  <div class="container-main">
    <section class="hero" style="padding-bottom: 40px;">
      <h1 class="hero-title">Books</h1>
      <p class="hero-intro">
        What I'm reading and books that shaped my thinking.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Currently Reading</h2>
      <div class="links-list">
        {currentlyReading.map((book) => (
          <div class="link-item">
            <span class="link-title">{book.title}</span>
            <span class="link-meta">{book.author}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Completed</h2>
      <div class="links-list">
        {completed.map((book) => (
          <div class="link-item">
            <div>
              <span class="link-title">{book.title}</span>
              <span style="display: block; font-size: 14px; color: var(--foreground-muted); margin-top: 4px;">
                {book.author}
              </span>
            </div>
            <span class="link-meta" style="color: #fbbf24;">{stars(book.rating)}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
