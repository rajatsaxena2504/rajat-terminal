---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: "Foundations",
    items: [
      "Linear algebra & calculus basics",
      "Probability & statistics",
      "Python for ML"
    ]
  },
  {
    title: "Machine Learning",
    items: [
      "Supervised learning (regression, classification)",
      "Unsupervised learning (clustering, dimensionality reduction)",
      "Model evaluation & cross-validation"
    ]
  },
  {
    title: "Deep Learning",
    items: [
      "Neural network fundamentals",
      "CNNs for computer vision",
      "RNNs and sequence models",
      "Transformers & attention"
    ]
  },
  {
    title: "LLMs & Applications",
    items: [
      "Transformer architecture deep dive",
      "Pre-training & fine-tuning",
      "Prompt engineering",
      "RAG & vector databases",
      "AI agents & tool use"
    ]
  },
  {
    title: "Production ML",
    items: [
      "ML pipelines & orchestration",
      "Model serving & inference",
      "Monitoring & observability",
      "MLOps best practices"
    ]
  }
];
---

<BaseLayout title="AI Guide" description="A roadmap for learning AI and machine learning.">
  <div class="container-main">
    <section class="hero" style="padding-bottom: 40px;">
      <h1 class="hero-title">AI Guide</h1>
      <p class="hero-intro">
        A structured roadmap for learning AI and ML, based on my own journey.
        From fundamentals to production systems.
      </p>
    </section>

    {sections.map((section, i) => (
      <section class="section">
        <h2 class="section-title">
          {i + 1}. {section.title}
        </h2>
        <ul style="list-style: none; padding: 0;">
          {section.items.map((item) => (
            <li style="padding: 12px 0; border-bottom: 1px solid var(--border); color: var(--foreground-secondary);">
              {item}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="section">
      <h2 class="section-title">Resources</h2>
      <div class="links-list">
        <a href="https://fast.ai" class="link-item" target="_blank" rel="noopener">
          <span class="link-title">fast.ai</span>
          <span class="link-meta">Practical deep learning</span>
        </a>
        <a href="https://karpathy.ai" class="link-item" target="_blank" rel="noopener">
          <span class="link-title">Andrej Karpathy</span>
          <span class="link-meta">Neural networks from scratch</span>
        </a>
        <a href="#" class="link-item">
          <span class="link-title">CS229 (Stanford)</span>
          <span class="link-meta">ML fundamentals</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
