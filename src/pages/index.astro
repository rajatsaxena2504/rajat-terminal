---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get recent blog posts
const allPosts = await getCollection('blogs', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Home">
  <div class="container-main">
    <!-- Hero - Simple like Chip Huyen -->
    <section class="hero">
      <h1 class="hero-title">
        <span class="glitch-text" data-text="Rajat">Rajat</span>
      </h1>
      <div class="hero-intro">
        <p>
          I'm a builder and creator working at the intersection of AI and software engineering.
          I write about <a href="/blogs">things I'm learning</a>, share <a href="/projects">projects I'm building</a>,
          and document <a href="/books">books I'm reading</a>.
        </p>
        <p style="margin-top: 20px;">
          Currently exploring LLMs, agents, and building tools that help people work smarter.
          Previously worked on ML systems at scale.
        </p>
        <p style="margin-top: 20px; color: var(--foreground-muted);">
          <a href="mailto:your@email.com">Email</a> ·
          <a href="https://twitter.com/yourusername">Twitter</a> ·
          <a href="https://github.com/yourusername">GitHub</a>
        </p>
      </div>
    </section>

    <!-- Recent Writing -->
    <section class="section">
      <h2 class="section-title">Recent Writing</h2>
      <div class="links-list">
        {recentPosts.length > 0 ? (
          recentPosts.map((post) => (
            <a href={`/blogs/${post.slug}`} class="link-item">
              <span class="link-title">{post.data.title}</span>
              <span class="link-meta">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </span>
            </a>
          ))
        ) : (
          <p style="color: var(--foreground-muted);">Coming soon...</p>
        )}
      </div>
      <a href="/blogs" style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        View all posts →
      </a>
    </section>

    <!-- Featured Projects -->
    <section class="section">
      <h2 class="section-title">Projects</h2>
      <div class="links-list">
        <a href="/projects" class="link-item">
          <span class="link-title">Neural Search Engine</span>
          <span class="link-meta">Python, FastAPI</span>
        </a>
        <a href="/projects" class="link-item">
          <span class="link-title">Paper Digest</span>
          <span class="link-meta">LLM, RAG</span>
        </a>
        <a href="/projects" class="link-item">
          <span class="link-title">ML Pipeline Framework</span>
          <span class="link-meta">Python, Docker</span>
        </a>
      </div>
      <a href="/projects" style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        View all projects →
      </a>
    </section>

    <!-- Currently Reading -->
    <section class="section">
      <h2 class="section-title">Currently Reading</h2>
      <div class="links-list">
        <div class="link-item">
          <span class="link-title">Staff Engineer</span>
          <span class="link-meta">Will Larson</span>
        </div>
        <div class="link-item">
          <span class="link-title">Designing Data-Intensive Applications</span>
          <span class="link-meta">Martin Kleppmann</span>
        </div>
      </div>
      <a href="/books" style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        View reading list →
      </a>
    </section>
  </div>
</BaseLayout>
