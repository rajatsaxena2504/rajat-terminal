---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Get recent content from all sections
const allPosts = await getCollection('blogs', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allPapers = await getCollection('papers', ({ data }) => !data.draft);
const recentPapers = allPapers
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const recentNotes = allNotes
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allBooks = await getCollection('books');
const currentlyReading = allBooks.filter(book => book.data.status === 'reading').slice(0, 2);
---

<BaseLayout title="Home">
  <!-- HERO: Bio-Focused Layout -->
  <section class="hero-about">
    <!-- Background layers -->
    <div class="bio-bg-grid"></div>
    <div class="bio-bg-gradient"></div>

    <!-- Two column layout -->
    <div class="bio-layout">
      <!-- Left: Bio content -->
      <div class="bio-content">
        <p class="bio-text">
          Hi, I'm a software engineer passionate about building <strong>distributed systems</strong> and <strong>ML infrastructure</strong>. I believe in learning in public and sharing knowledge through writing, code, and deep dives into research papers.
        </p>
        <p class="bio-text">
          Currently, I'm focused on designing scalable backend architectures and exploring the intersection of systems engineering and machine learning. I enjoy breaking down complex technical concepts and documenting my learning journey.
        </p>
        <p class="bio-text">
          When I'm not coding, you'll find me reading technical papers, exploring new programming paradigms, or working through my ever-growing reading list. I'm always open to connecting with fellow engineers and discussing interesting problems.
        </p>

        <!-- Navigation links -->
        <div class="bio-nav">
          <a href={`${base}papers/`} class="bio-nav-link">Paper Notes</a>
          <a href={`${base}projects/`} class="bio-nav-link">Projects</a>
          <a href={`${base}blogs/`} class="bio-nav-link">Blog</a>
          <a href={`${base}notes/`} class="bio-nav-link">Notes</a>
        </div>
      </div>

      <!-- Right: Photo + Name + Social -->
      <div class="bio-profile">
        <div class="bio-photo-wrapper">
          <img src={`${base}profile.jpeg`} alt="Rajat Saxena" class="bio-photo" />
        </div>

        <h1 class="bio-name">Rajat Saxena</h1>
        <p class="bio-role">Associate Partner @ ZS</p>
        <div class="bio-motto">
          <span class="motto-text">Forever Building, Forever Learning</span>
        </div>

        <!-- Social icons -->
        <div class="bio-social">
          <a href="https://github.com/rajatsaxena2504" target="_blank" rel="noopener" class="bio-social-link" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="https://twitter.com/rajatsaxena2504" target="_blank" rel="noopener" class="bio-social-link" aria-label="Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/rajat-saxena-791aa650/" target="_blank" rel="noopener" class="bio-social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container-main">
    <!-- Recent Paper Notes -->
    <section class="section">
      <h2 class="section-title">Paper Notes</h2>
      <div class="links-list">
        {recentPapers.length > 0 ? (
          recentPapers.map((paper) => (
            <a href={`${base}papers/${paper.slug}/`} class="link-item">
              <span class="link-title">{paper.data.title}</span>
              <span class="link-meta">
                {paper.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </span>
            </a>
          ))
        ) : (
          <p style="color: var(--foreground-muted);">Paper notes coming soon...</p>
        )}
      </div>
      <a href={`${base}papers/`} style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        All paper notes →
      </a>
    </section>

    <!-- Recent Learning Notes -->
    <section class="section">
      <h2 class="section-title">Learning Notes</h2>
      <div class="links-list">
        {recentNotes.length > 0 ? (
          recentNotes.map((note) => (
            <a href={`${base}notes/${note.slug}/`} class="link-item">
              <span class="link-title">{note.data.title}</span>
              <span class="link-meta" style="text-transform: capitalize;">
                {note.data.category.replace('-', ' ')}
              </span>
            </a>
          ))
        ) : (
          <p style="color: var(--foreground-muted);">Notes coming soon...</p>
        )}
      </div>
      <a href={`${base}notes/`} style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        All notes →
      </a>
    </section>

    <!-- Recent Writing -->
    <section class="section">
      <h2 class="section-title">Blog</h2>
      <div class="links-list">
        {recentPosts.length > 0 ? (
          recentPosts.map((post) => (
            <a href={`${base}blogs/${post.slug}/`} class="link-item">
              <span class="link-title">{post.data.title}</span>
              <span class="link-meta">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </span>
            </a>
          ))
        ) : (
          <p style="color: var(--foreground-muted);">Blog posts coming soon...</p>
        )}
      </div>
      <a href={`${base}blogs/`} style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        All posts →
      </a>
    </section>

    <!-- Currently Reading -->
    <section class="section">
      <h2 class="section-title">Currently Reading</h2>
      <div class="links-list">
        {currentlyReading.length > 0 ? (
          currentlyReading.map((book) => (
            <div class="link-item">
              <span class="link-title">{book.data.title}</span>
              <span class="link-meta">{book.data.author}</span>
            </div>
          ))
        ) : (
          <>
            <div class="link-item">
              <span class="link-title">Staff Engineer</span>
              <span class="link-meta">Will Larson</span>
            </div>
            <div class="link-item">
              <span class="link-title">Designing Data-Intensive Applications</span>
              <span class="link-meta">Martin Kleppmann</span>
            </div>
          </>
        )}
      </div>
      <a href={`${base}books/`} style="display: inline-block; margin-top: 24px; font-size: 14px; color: var(--accent);">
        View reading list →
      </a>
    </section>
  </div>
</BaseLayout>
